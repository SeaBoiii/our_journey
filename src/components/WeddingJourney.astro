---
import CloudField from "./CloudField.astro";
import CloudPass from "./CloudPass.astro";
import MusicControl from "./MusicControl.astro";
import PavilionCurtains from "./PavilionCurtains.astro";
import RSVPForm from "./RSVPForm";
import WeddingCountdown from "./WeddingCountdown.astro";
import type { InviteCodeData } from "../data/invitation";
import { wedding } from "../data/wedding";

interface Props {
  invite?: InviteCodeData;
}

const { invite } = Astro.props;
const partnerDisplay = wedding.couple.bride.startsWith("[")
  ? "A"
  : wedding.couple.bride;
const finalPartnerDisplay = wedding.couple.finalBride.startsWith("[")
  ? "A"
  : wedding.couple.finalBride;
const maxGuests = invite?.maxPax ?? 4;
const contactSide = invite?.side ?? wedding.defaultContactSide;
const contactVariant = wedding.contactVariants[contactSide];
const storageKey = invite
  ? `our-journey:rsvp:${invite.code.toLowerCase()}`
  : "our-journey:rsvp";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\/+/, "")}`;
const assetSrcset = (sources: ReadonlyArray<readonly [string, number]>) =>
  sources.map(([path, width]) => `${withBase(path)} ${width}w`).join(", ");
---

<div class="journey-shell" data-journey-root>
  <div class="sky-world" aria-hidden="true">
    <picture class="sky-picture">
      <source
        media="(max-width: 520px)"
        srcset={assetSrcset([
          ["assets/sky/sky-gradient-480.webp", 480],
          ["assets/sky/sky-gradient-640.webp", 640],
        ])}
        sizes="100vw"
      />
      <source
        srcset={assetSrcset([
          ["assets/sky/sky-gradient-640.webp", 640],
          ["assets/sky/sky-gradient.webp", 864],
        ])}
        sizes="100vw"
      />
      <img
        src={withBase("assets/sky/sky-gradient.webp")}
        alt=""
        width="864"
        height="1821"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="sun-wash"></div>
    <div class="sky-grain"></div>
  </div>

  <header class="journey-nav" aria-label="Invitation progress">
    <a class="mini-monogram" href="#arrival" aria-label="Return to the beginning">
      <img src={withBase("assets/ornaments/monogram.svg")} alt="" width="54" height="40" />
    </a>
    <div class="progress-track" aria-hidden="true">
      <span class="progress-fill" data-progress></span>
    </div>
  </header>

  <MusicControl
    enabled={wedding.audio.enabled}
    title={wedding.audio.title}
    src={wedding.audio.src}
  />

  <main id="main-content">
    <section class="scene arrival" id="arrival" data-scene="arrival">
      <div class="scene-sticky arrival-stage">
        <CloudField class="arrival-clouds" id="arrival-clouds" />
        <div class="opening-copy" data-opening-copy>
          <p class="basmala" lang="ar" dir="rtl" data-opening-line>
            {wedding.opening.basmala}
          </p>
          <p class="opening-salam" lang="ms" data-opening-line>
            {wedding.opening.salam}
          </p>
          {
            invite ? (
              <div class="guest-welcome" data-opening-line>
                <p>{invite.greeting}</p>
                <span>{invite.reservationMessage}</span>
              </div>
            ) : null
          }
          <img
            class="hero-monogram"
            src={withBase("assets/ornaments/monogram.svg")}
            alt="A plus A monogram"
            width="160"
            height="120"
            data-opening-line
          />
          <p class="family-line" data-opening-line>{wedding.opening.familyLine}</p>
          <h1 class="couple-names" data-opening-line>
            <span>{wedding.couple.groom}</span>
            <span class="ampersand">&amp;</span>
            <span>{partnerDisplay}</span>
          </h1>
          <p class="invitation-line" data-opening-line>
            <span>{wedding.opening.invitationLine[0]}</span>
            <span>{wedding.opening.invitationLine[1]}</span>
          </p>
        </div>
        <a class="scroll-cue" href="#ascension" data-scroll-cue>
          <span class="scroll-arrow" aria-hidden="true">↓</span>
          <span>{wedding.opening.scrollCue}</span>
        </a>
      </div>
    </section>

    <section class="scene skyward-journey" data-scene="skyward">
      <div class="skyward-stage" data-shared-stage>
        <CloudField class="pavilion-clouds" id="pavilion-clouds" />

        <div class="stair-light" aria-hidden="true"></div>
        <div class="final-ascent-glow" data-final-ascent-glow aria-hidden="true"></div>
        <div class="staircase-anchor">
          <picture class="staircase-picture" data-staircase>
            <source
              media="(max-width: 520px)"
              srcset={assetSrcset([
                ["assets/stairs/staircase-painterly-480.webp", 480],
                ["assets/stairs/staircase-painterly-640.webp", 640],
                ["assets/stairs/staircase-painterly.webp", 903],
              ])}
              sizes="116vw"
            />
            <img
              src={withBase("assets/stairs/staircase-painterly.webp")}
              alt="An ivory staircase rising through the clouds toward the pavilion"
              width="903"
              height="1742"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </picture>
        </div>
        <div class="stair-fog stair-fog--upper" data-stair-fog="upper" aria-hidden="true"></div>
        <div class="stair-fog stair-fog--lower" data-stair-fog="lower" aria-hidden="true"></div>
        <div class="edge-cloud edge-cloud--left" data-ascent-cloud aria-hidden="true"></div>
        <div class="edge-cloud edge-cloud--right" data-ascent-cloud aria-hidden="true"></div>

        <div class="pavilion-distant-preview" data-pavilion-preview aria-hidden="true">
          <img
            src={withBase("assets/pavilion/pavilion-painterly-640.webp")}
            alt=""
            width="640"
            height="427"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        </div>

        <div class="pavilion-rsvp-shift" data-pavilion-rsvp-shift>
        <div class="pavilion-assembly" data-pavilion-assembly>
          <picture class="pavilion-picture">
            <source
              media="(max-width: 700px)"
              srcset={assetSrcset([
                ["assets/pavilion/pavilion-painterly-640.webp", 640],
                ["assets/pavilion/pavilion-painterly-768.webp", 768],
                ["assets/pavilion/pavilion-painterly.webp", 1536],
              ])}
              sizes="180vw"
            />
            <source
              srcset={assetSrcset([
                ["assets/pavilion/pavilion-painterly-1024.webp", 1024],
                ["assets/pavilion/pavilion-painterly.webp", 1536],
              ])}
              sizes="min(92vw, 1120px)"
            />
            <img
              src={withBase("assets/pavilion/pavilion-painterly.webp")}
              alt="An intimate ivory pavilion waiting at the top of the stairs"
              width="1536"
              height="1024"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </picture>

          <div class="couple-anchor" data-couple>
            <span class="couple-ground-shadow" aria-hidden="true"></span>
            <picture class="couple-picture">
              <source
                media="(max-width: 520px)"
                srcset={assetSrcset([
                  ["assets/couple/couple-main-480.webp", 480],
                  ["assets/couple/couple-main-640.webp", 640],
                ])}
                sizes="62vw"
              />
              <source
                srcset={assetSrcset([
                  ["assets/couple/couple-main-640.webp", 640],
                  ["assets/couple/couple-main.webp", 853],
                ])}
                sizes="min(38vw, 440px)"
              />
              <img
                src={withBase("assets/couple/couple-main.webp")}
                alt="An illustrated Muslim newlywed couple sharing a quiet embrace"
                width="853"
                height="1844"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <img
              class="ring-hand-layer"
              src={withBase("assets/couple/bride-ring-hand-optimized.webp")}
              srcset={assetSrcset([
                ["assets/couple/bride-ring-hand-480.webp", 480],
                ["assets/couple/bride-ring-hand-640.webp", 640],
                ["assets/couple/bride-ring-hand-optimized.webp", 853],
              ])}
              sizes="(max-width: 520px) 62vw, min(38vw, 440px)"
              alt=""
              width="853"
              height="1844"
              loading="lazy"
              decoding="async"
              data-ring-hand
              aria-hidden="true"
            />
            <span class="ring-contact" aria-hidden="true"></span>
            <img
              class="ring-glint"
              src={withBase("assets/couple/ring-highlight.svg")}
              alt=""
              width="128"
              height="128"
              data-ring-glint
              aria-hidden="true"
            />
            <span class="couple-light" aria-hidden="true"></span>
          </div>

          <PavilionCurtains class="pavilion-curtains" />
          <img
            class="pavilion-cloud-bank"
            src={withBase("assets/clouds/cloud-foreground-rise.webp")}
            alt=""
            width="1040"
            height="453"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            aria-hidden="true"
          />
        </div>
        </div>

        <div class="crest-haze" data-crest-haze aria-hidden="true"></div>
        <div class="reveal-haze" data-reveal-haze aria-hidden="true"></div>

        <div class="final-copy-shift" data-final-copy-shift>
        <div class="final-copy" data-final-copy>
          <p class="final-message">
            <span>{wedding.finalMessage[0]}</span>
            <em>{wedding.finalMessage[1]}</em>
          </p>
          <p class="final-names">
            {wedding.couple.groom} &amp; {finalPartnerDisplay}
          </p>
          <time datetime={wedding.event.isoDate}>{wedding.event.numericDate}</time>
          <img src={withBase("assets/ornaments/divider.svg")} alt="" width="300" height="28" />
          <p class="attendance-request">
            <span>{wedding.attendanceRequest[0]}</span>
            <span>{wedding.attendanceRequest[1]}</span>
          </p>
          <a
            class="rsvp-link"
            href="#rsvp"
            data-rsvp-open
            aria-haspopup="dialog"
            aria-controls="rsvp"
          >
            <span>RSVP</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
        </div>
      </div>

      <div class="skyward-scroll-track">
        <section class="ascension" id="ascension" data-phase="ascension">
          <div class="ascent-copy-track">
            <div class="ascent-breath" aria-hidden="true"></div>

            <article class="ascent-beat save-date-beat" data-ascent-beat data-story-beat="date">
              <h2 class="eyebrow">{wedding.saveTheDate.label}</h2>
              <time datetime={wedding.event.isoDate} class="save-date-lockup">
                <strong>{wedding.saveTheDate.day}</strong>
                <span>{wedding.saveTheDate.month}</span>
                <span>{wedding.saveTheDate.year}</span>
              </time>
              <p class="save-date-weekday">{wedding.saveTheDate.weekday}</p>
            </article>

            <article
              class="ascent-beat formal-invitation"
              data-ascent-beat
              data-story-beat="invitation"
              lang="ms"
            >
              <h2 class="eyebrow">{wedding.formalInvitation.eyebrow}</h2>
              <p class="formal-gratitude">
                <span>{wedding.formalInvitation.gratitude[0]}</span>
                <span>{wedding.formalInvitation.gratitude[1]}</span>
              </p>
              <p class="formal-family">
                <span>{wedding.formalInvitation.familyInvitation[0]}</span>
                <span>{wedding.formalInvitation.familyInvitation[1]}</span>
              </p>
              <p class="formal-honorifics">
                <span>{wedding.formalInvitation.honorifics[0]}</span>
                <span>{wedding.formalInvitation.honorifics[1]}</span>
              </p>
              <p class="formal-ceremony-line">{wedding.formalInvitation.ceremonyLine}</p>
              <p class="formal-names">
                <span>{wedding.couple.groom}</span>
                <em>&amp;</em>
                <span>{partnerDisplay}</span>
              </p>
            </article>

            <article class="ascent-beat event-details" data-ascent-beat data-story-beat="celebration">
              <p class="eyebrow">The celebration</p>
              <h2 class="weekday">{wedding.event.weekday}</h2>
              <time datetime={wedding.event.isoDate} class="event-date">
                {wedding.event.date}
              </time>
              <p class="event-time">{wedding.event.time}</p>
              <img src={withBase("assets/ornaments/divider.svg")} alt="" width="360" height="32" />
              <p class="venue">{wedding.venue.name}</p>
              <p class="location">{wedding.venue.address}</p>
            </article>

            <article class="ascent-beat story-beat" data-ascent-beat data-story-beat="story">
              <CloudPass
                event="story"
                src="assets/clouds/cloud-mid-drift.webp"
                width={720}
                height={248}
              />
              <h2 class="eyebrow">{wedding.story.heading}</h2>
              <blockquote>“{wedding.story.quote}”</blockquote>
              <div class="story-lines">
                {wedding.story.lines.map((line) => <p>{line}</p>)}
              </div>
            </article>

            <section class="itinerary-ascent" aria-labelledby="itinerary-title">
              <div
                class="ascent-beat itinerary-scene"
                data-ascent-beat
                data-story-beat="itinerary"
              >
                <p class="eyebrow">The celebration</p>
                <h2 id="itinerary-title">Itinerary</h2>
                <ol class="stair-schedule">
                  {
                    wedding.schedule.map((item, index) => (
                      <li
                        class:list={["schedule-level", index % 2 === 0 ? "schedule-level--left" : "schedule-level--right"]}
                      >
                        <span class="schedule-ornament" aria-hidden="true"></span>
                        <time>{item.time}</time>
                        <p>{item.label}</p>
                      </li>
                    ))
                  }
                </ol>
              </div>
            </section>

            <article class="ascent-beat doa-beat" data-ascent-beat data-story-beat="doa" lang="ms">
              <CloudPass
                event="doa"
                src="assets/clouds/cloud-distant-wisp.webp"
                width={520}
                height={114}
              />
              <h2>{wedding.doa.heading}</h2>
              <p class="doa-arabic" lang="ar" dir="rtl">{wedding.doa.arabic}</p>
              <img src={withBase("assets/ornaments/divider.svg")} alt="" width="300" height="28" />
              <p class="doa-label">{wedding.doa.languageLabel}</p>
              <p class="doa-meaning">{wedding.doa.meaning}</p>
            </article>

            <article class="ascent-beat location-beat" data-ascent-beat data-story-beat="location">
              <p class="eyebrow">The celebration awaits</p>
              <h2>Finding your way to us</h2>
              <p class="location-venue">{wedding.venue.name}</p>
              <p class="location-address">{wedding.venue.address}</p>
              {
                wedding.venue.googleMapsUrl || wedding.venue.wazeUrl ? (
                  <nav class="location-actions" aria-label="Venue navigation links">
                    {wedding.venue.googleMapsUrl ? (
                      <a href={wedding.venue.googleMapsUrl} target="_blank" rel="noreferrer">
                        View location <span aria-hidden="true">↗</span>
                      </a>
                    ) : null}
                    {wedding.venue.wazeUrl ? (
                      <a href={wedding.venue.wazeUrl} target="_blank" rel="noreferrer">
                        Navigate <span aria-hidden="true">↗</span>
                      </a>
                    ) : null}
                  </nav>
                ) : null
              }
            </article>

            {
              wedding.contacts.length > 0 ? (
                <article class="ascent-beat contact-beat" data-ascent-beat data-story-beat="contact">
                  <p class="eyebrow">Need a little help?</p>
                  <h2>Our families are here</h2>
                  <ul>
                    {wedding.contacts.map((contact) => (
                      <li>
                        <span>{contact.label}</span>
                        <strong>{contact.name}</strong>
                        <a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}>{contact.phone}</a>
                      </li>
                    ))}
                  </ul>
                </article>
              ) : null
            }

            <div class="final-ascent-breath" data-final-ascent aria-hidden="true">
              <CloudPass
                event="final"
                src="assets/clouds/cloud-foreground-bank.webp"
                width={960}
                height={391}
              />
              <span></span>
            </div>
          </div>
        </section>

        <section class="pavilion-journey" id="pavilion" data-phase="pavilion" aria-label="The pavilion">
          <div class="pavilion-scroll-space" aria-hidden="true"></div>
        </section>
      </div>
    </section>

  </main>
</div>

<div class="rsvp-transition-cloud" data-rsvp-transition-cloud aria-hidden="true">
  <img
    src={withBase("assets/clouds/cloud-foreground-bank.webp")}
    alt=""
    width="960"
    height="391"
    decoding="async"
  />
</div>

<section
  class="rsvp-section"
  id="rsvp"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rsvp-section-title"
  aria-hidden="true"
  inert
  data-rsvp-scene
  data-rsvp-scroll
>
  <div class="rsvp-scene-content">
    <img
      class="floral floral--left"
      src={withBase("assets/ornaments/floral-accent-left.svg")}
      alt=""
      width="260"
      height="188"
      loading="lazy"
    />
    <img
      class="floral floral--right"
      src={withBase("assets/ornaments/floral-accent-right.svg")}
      alt=""
      width="260"
      height="188"
      loading="lazy"
    />
    <div class="rsvp-heading">
      <p class="eyebrow">One last step</p>
      <h2 id="rsvp-section-title" tabindex="-1" data-rsvp-focus>Will you join us?</h2>
      {
        invite ? (
          <div class="rsvp-reservation">
            <p>{invite.greeting}</p>
            <span>{invite.reservationMessage}</span>
          </div>
        ) : null
      }
    </div>
    <div class="rsvp-countdown">
      <WeddingCountdown
        enabled={wedding.countdown.enabled}
        target={wedding.countdown.targetDateTime}
        todayMessage={wedding.countdown.todayMessage}
        completedMessage={wedding.countdown.completedMessage}
      />
    </div>
    <RSVPForm
      client:load
      defaultName={invite?.guestName ?? ""}
      maxGuests={maxGuests}
      storageKey={storageKey}
    />

    <section
      class="rsvp-assistance"
      aria-labelledby="rsvp-assistance-title"
      data-contact-side={contactSide}
    >
      <p class="eyebrow">Need assistance?</p>
      <h3 id="rsvp-assistance-title">{contactVariant.heading}</h3>
      <ul>
        {
          contactVariant.contacts.map((contact) => (
            <li>
              <span>{contact.label}</span>
              <strong>{contact.name}</strong>
              {contact.phone ? (
                <a href={`tel:${String(contact.phone).replace(/[^+\d]/g, "")}`}>{contact.phone}</a>
              ) : (
                <small>Number to be confirmed</small>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="site-footer">
      <img
        src={withBase("assets/ornaments/monogram.svg")}
        alt=""
        width="72"
        height="54"
        loading="lazy"
      />
      <p>Made with love, beneath the same sky.</p>
      <button type="button" data-rsvp-close>← Return to invitation</button>
    </footer>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({
    ignoreMobileResize: true,
  });

  const usesPortraitFinalComposition = () =>
    window.innerWidth < 768 && window.matchMedia("(orientation: portrait)").matches;
  const syncFinalCopyAnchor = () => {
    const finalCopy = document.querySelector<HTMLElement>("[data-final-copy]");
    if (finalCopy) gsap.set(finalCopy, { yPercent: usesPortraitFinalComposition() ? 0 : -50 });
  };

  let orientationRefreshTimer: number | undefined;
  let orientationRefreshPending = false;
  const refreshAfterOrientationChange = () => {
    if (orientationRefreshTimer !== undefined) window.clearTimeout(orientationRefreshTimer);
    orientationRefreshTimer = window.setTimeout(() => {
      orientationRefreshTimer = undefined;
      syncFinalCopyAnchor();
      if (document.documentElement.classList.contains("is-rsvp-open")) {
        orientationRefreshPending = true;
        return;
      }
      ScrollTrigger.refresh();
    }, 250);
  };

  window.addEventListener("orientationchange", refreshAfterOrientationChange);
  window.addEventListener(
    "pagehide",
    () => {
      if (orientationRefreshTimer !== undefined) window.clearTimeout(orientationRefreshTimer);
      window.removeEventListener("orientationchange", refreshAfterOrientationChange);
    },
    { once: true },
  );

  const root = document.querySelector<HTMLElement>("[data-journey-root]");

  if (root) {
    const select = gsap.utils.selector(root);
    const motion = gsap.matchMedia();
    const cloudFields = select<HTMLElement>("[data-cloud-field]");
    const cloudPasses = select<HTMLElement>("[data-cloud-pass]");
    const ascentBeats = select<HTMLElement>("[data-ascent-beat]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if ("IntersectionObserver" in window) {
      const cloudObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target
              .querySelectorAll<HTMLElement>("[data-cloud], [data-mist], [data-particle]")
              .forEach((layer) => {
                layer.style.animationPlayState = entry.isIntersecting ? "running" : "paused";
              });
          });
        },
        { rootMargin: "35% 0px" },
      );

      cloudFields.forEach((field) => cloudObserver.observe(field));

      const cloudPassObserver = prefersReducedMotion
        ? null
        : new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  cloudPasses.forEach((pass) => {
                    pass.classList.toggle("is-active", pass === entry.target);
                  });
                } else {
                  entry.target.classList.remove("is-active");
                }
              });
            },
            { rootMargin: "30% 0px" },
          );

      const cloudPassEndHandlers = cloudPasses.map((pass) => {
        const image = pass.querySelector("img");
        const handleEnd = () => pass.classList.remove("is-active");
        image?.addEventListener("animationend", handleEnd);
        cloudPassObserver?.observe(pass);
        return { image, handleEnd };
      });

      window.addEventListener(
        "pagehide",
        () => {
          cloudObserver.disconnect();
          cloudPassObserver?.disconnect();
          cloudPassEndHandlers.forEach(({ image, handleEnd }) => {
            image?.removeEventListener("animationend", handleEnd);
          });
        },
        { once: true },
      );
    }

    motion.add("(prefers-reduced-motion: no-preference)", () => {
      const setActiveAscentBeat = (activeBeat: HTMLElement | null) => {
        ascentBeats.forEach((beat) => {
          beat.classList.toggle("is-active", beat === activeBeat);
        });
      };
      const syncActiveAscentBeat = () => {
        const viewportCenter = window.innerHeight / 2;
        const activeBeat = ascentBeats.find((beat) => {
          const bounds = beat.getBoundingClientRect();
          return bounds.top <= viewportCenter && bounds.bottom >= viewportCenter;
        });
        setActiveAscentBeat(activeBeat ?? null);
      };
      const ascentBeatTriggers = ascentBeats.map((beat) =>
        ScrollTrigger.create({
          trigger: beat,
          start: "top center",
          end: "bottom center",
          onEnter: () => setActiveAscentBeat(beat),
          onEnterBack: () => setActiveAscentBeat(beat),
          onRefresh: syncActiveAscentBeat,
        }),
      );
      const initialAscentSync = window.requestAnimationFrame(syncActiveAscentBeat);
      root.classList.toggle("has-ascent-reveals", ascentBeats.length > 0);

      const progress = root.querySelector<HTMLElement>("[data-progress]");

      if (progress) {
        gsap.set(progress, { scaleY: 0, transformOrigin: "top center" });
        const setProgress = gsap.quickSetter(progress, "scaleY");
        ScrollTrigger.create({
          start: 0,
          end: "max",
          onUpdate: (self) => setProgress(self.progress),
        });
      }

      const openingLines = select("[data-opening-line]");
      gsap.from(openingLines, {
        autoAlpha: 0,
        y: 18,
        duration: 1.25,
        stagger: 0.16,
        ease: "power2.out",
        delay: 0.15,
      });

      const arrival = root.querySelector<HTMLElement>("[data-scene='arrival']");
      if (arrival) {
        const compactCloudBudget = window.matchMedia("(max-width: 47.9375rem)").matches;
        const frontA = arrival.querySelector<HTMLElement>("[data-cloud='front-a']");
        const frontB = arrival.querySelector<HTMLElement>("[data-cloud='front-b']");
        const midA = arrival.querySelector<HTMLElement>("[data-cloud='mid-a']");
        const mist = arrival.querySelector<HTMLElement>("[data-layer='mist']");
        const opening = arrival.querySelector<HTMLElement>("[data-opening-copy]");
        const cue = arrival.querySelector<HTMLElement>("[data-scroll-cue]");
        const movingClouds = [frontA, midA, ...(compactCloudBudget ? [] : [frontB])].filter(
          (cloud): cloud is HTMLElement => Boolean(cloud),
        );
        const setArrivalMotion = (active: boolean) => {
          movingClouds.forEach((cloud) => cloud.classList.toggle("is-moving", active));
          arrival.classList.toggle("is-complete", !active);
        };

        setArrivalMotion(true);

        const arrivalTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: arrival,
            start: "top top",
            end: "bottom bottom",
            scrub: 1.1,
            onEnter: () => setArrivalMotion(true),
            onEnterBack: () => setArrivalMotion(true),
            onLeave: () => setArrivalMotion(false),
          },
        });

        arrivalTimeline
          .to(frontA, { x: "-28vw", y: "8vh", scale: 1.08, ease: "sine.inOut" }, 0)
          .to(midA, { x: "-13vw", y: "3vh", scale: 1.03 }, 0.06)
          .to(mist, { autoAlpha: 0.12 }, 0)
          .to(cue, { autoAlpha: 0, y: 18 }, 0)
          .to(opening, { autoAlpha: 0.12, y: "-10vh", scale: 0.97 }, 0.18);

        if (!compactCloudBudget) {
          arrivalTimeline.to(frontB, { x: "29vw", y: "-3vh", scale: 1.05, ease: "sine.inOut" }, 0);
        }
      }

      const ascensionPhase = root.querySelector<HTMLElement>("[data-phase='ascension']");
      const finalAscentPhase = root.querySelector<HTMLElement>("[data-final-ascent]");
      const pavilionPhase = root.querySelector<HTMLElement>("[data-phase='pavilion']");
      const staircase = root.querySelector<HTMLElement>("[data-staircase]");
      const pavilionPreview = root.querySelector<HTMLElement>("[data-pavilion-preview]");
      const pavilionPreviewPicture = pavilionPreview?.querySelector<HTMLElement>("img");
      const pavilionAssembly = root.querySelector<HTMLElement>("[data-pavilion-assembly]");
      const pavilionPicture = root.querySelector<HTMLElement>(".pavilion-picture");
      const pavilionClouds = root.querySelector<HTMLElement>(".pavilion-clouds");
      const pavilionBanks = select(".pavilion-cloud-bank");
      const pavilionCurtains = root.querySelector<HTMLElement>("[data-curtain-layer]");
      const ascentClouds = select("[data-ascent-cloud]");
      const upperStairFog = root.querySelector<HTMLElement>("[data-stair-fog='upper']");
      const lowerStairFog = root.querySelector<HTMLElement>("[data-stair-fog='lower']");
      const stairLight = root.querySelector<HTMLElement>(".stair-light");
      const finalAscentGlow = root.querySelector<HTMLElement>("[data-final-ascent-glow]");
      const crestHaze = root.querySelector<HTMLElement>("[data-crest-haze]");
      const couple = root.querySelector<HTMLElement>("[data-couple]");
      const coupleLight = root.querySelector<HTMLElement>(".couple-light");
      const ringHand = root.querySelector<HTMLElement>("[data-ring-hand]");
      const glint = root.querySelector<HTMLElement>("[data-ring-glint]");
      const revealHaze = root.querySelector<HTMLElement>("[data-reveal-haze]");
      const finalCopy = root.querySelector<HTMLElement>("[data-final-copy]");
      const compactEffects = window.matchMedia("(max-width: 47.9375rem)").matches;
      let glintTimer: number | undefined;
      let ringMomentActive = false;

      const setMovingState = (
        layers: Array<HTMLElement | null | undefined>,
        active: boolean,
      ) => {
        layers.forEach((layer) => layer?.classList.toggle("is-moving", active));
      };

      const setPavilionAmbientState = (progress: number, active = true) => {
        const curtainsActive = active && progress >= 0.46 && progress < 0.9;
        const coupleLightActive = active && progress >= 0.58 && progress < 0.91;
        pavilionCurtains?.classList.toggle("is-active", curtainsActive);
        coupleLight?.classList.toggle("is-active", coupleLightActive);
      };

      const clearGlintTimer = () => {
        if (glintTimer !== undefined) {
          window.clearTimeout(glintTimer);
          glintTimer = undefined;
        }
      };

      const scheduleGlint = (first = false) => {
        clearGlintTimer();
        if (!ringMomentActive || !glint) return;
        glintTimer = window.setTimeout(
          () => {
            if (!ringMomentActive) return;
            gsap
              .timeline({ onComplete: () => scheduleGlint(false) })
              .fromTo(
                glint,
                { autoAlpha: 0, scale: 0.4, rotate: -5 },
                { autoAlpha: 0.9, scale: 1, rotate: 0, duration: 0.38, ease: "power2.out" },
              )
              .to(glint, { autoAlpha: 0, scale: 0.7, duration: 0.48, ease: "sine.inOut" });
          },
          first ? 900 : 6500 + Math.random() * 3000,
        );
      };

      if (ascensionPhase && finalAscentPhase && pavilionPhase && staircase && pavilionPreview && pavilionPreviewPicture && pavilionAssembly && pavilionPicture && couple && finalCopy) {
        const stairAscentScale = () => {
          if (window.innerWidth >= 1120) return 1.54;
          if (window.innerWidth >= 768) return 1.7;
          return 2.08;
        };
        const stairLandingY = () => {
          const anchor = staircase.parentElement;
          return (anchor?.offsetTop ?? 0) + staircase.offsetTop + staircase.offsetHeight * 0.0631;
        };
        const pavilionBaseY = () => pavilionPicture.offsetTop + pavilionPicture.offsetHeight * 0.913;
        const pavilionOriginY = () => pavilionAssembly.offsetHeight * 0.72;
        const pavilionDistantY = (scale: number) => {
          const origin = pavilionOriginY();
          return stairLandingY() - (origin + (pavilionBaseY() - origin) * scale);
        };
        const stairSummitTravel = () => pavilionBaseY() - stairLandingY();
        const pavilionApproachY = (scale: number, stairProgress: number) =>
          pavilionDistantY(scale) + stairSummitTravel() * stairProgress;
        const finalSceneLift = () => {
          if (window.innerWidth >= 1120) return "-30vh";
          if (window.innerWidth >= 768) return "-34vh";
          return usesPortraitFinalComposition() ? "-11vh" : "-31vh";
        };

        gsap.set(staircase, {
          autoAlpha: 0.18,
          scale: 0.94,
          y: 0,
          transformOrigin: "50% 6.31%",
        });
        gsap.set(pavilionAssembly, {
          autoAlpha: 0,
          scale: 0.14,
          y: () => pavilionDistantY(0.14),
          transformOrigin: "50% 72%",
        });
        gsap.set(pavilionPreview, {
          autoAlpha: 1,
          scale: 0.14,
          y: () => pavilionDistantY(0.14),
          transformOrigin: "50% 72%",
        });
        gsap.set(pavilionPreviewPicture, { autoAlpha: 0 });
        gsap.set(couple, {
          autoAlpha: 0,
          y: compactEffects ? 8 : 0,
          clipPath: compactEffects ? "none" : "inset(48% 0 0 0)",
        });
        gsap.set(pavilionBanks, { autoAlpha: 0.18 });
        gsap.set(pavilionCurtains, { autoAlpha: 0 });
        gsap.set(pavilionClouds, { autoAlpha: 0.22, scale: 1 });
        gsap.set(crestHaze, { autoAlpha: 0, scale: 0.82, yPercent: -8 });
        gsap.set(revealHaze, { autoAlpha: 0, y: "6vh" });
        gsap.set(finalAscentGlow, { autoAlpha: 0, scale: 0.9 });
        gsap.set(finalCopy, {
          autoAlpha: 0,
          xPercent: -50,
          yPercent: usesPortraitFinalComposition() ? 0 : -50,
          y: 24,
          pointerEvents: "none",
        });
        gsap.set(glint, { autoAlpha: 0, scale: 0.4 });

        const ascentMotionLayers = compactEffects
          ? [staircase, pavilionClouds]
          : [staircase, pavilionClouds, upperStairFog, lowerStairFog, finalAscentGlow];
        const pavilionMotionLayers = compactEffects
          ? [staircase, pavilionPreview, pavilionAssembly]
          : [staircase, pavilionPreview, pavilionAssembly, pavilionClouds, crestHaze, revealHaze, finalCopy];

        const ascensionTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: ascensionPhase,
            start: "top top",
            end: "bottom bottom",
            scrub: 0.95,
            invalidateOnRefresh: true,
            onToggle: (self) => setMovingState(ascentMotionLayers, self.isActive),
          },
        });

        ascensionTimeline
          .fromTo(
            staircase,
            { autoAlpha: 0.18, scale: 0.94 },
            { autoAlpha: 1, scale: stairAscentScale, duration: 1, ease: "none" },
            0,
          )
          .fromTo(
            pavilionClouds,
            { autoAlpha: 0.22, scale: 1 },
            { autoAlpha: 0.54, scale: 1.025, duration: 1, ease: "none" },
            0,
          )
          .fromTo(
            upperStairFog,
            { autoAlpha: 0.96, yPercent: 0 },
            { autoAlpha: 0.2, yPercent: 34, duration: 1, ease: "none" },
            0,
          )
          .fromTo(
            lowerStairFog,
            { autoAlpha: 0.94, yPercent: 0, scale: 1 },
            { autoAlpha: 0.24, yPercent: 58, scale: 1.46, duration: 1, ease: "none" },
            0,
          )
          .fromTo(
            ascentClouds,
            { autoAlpha: 0.94, yPercent: 0, scale: 1 },
            { autoAlpha: 0.22, yPercent: 52, scale: 1.34, duration: 1, ease: "none", stagger: 0.02 },
            0,
          )
          .to(stairLight, { autoAlpha: 0.92, scale: 1.12, duration: 0.14, ease: "sine.inOut" }, 0.86)
          .to(finalAscentGlow, { autoAlpha: 0.82, scale: 1.08, duration: 0.14, ease: "sine.out" }, 0.86);

        gsap.timeline({
          scrollTrigger: {
            trigger: finalAscentPhase,
            start: "top top",
            end: "bottom top",
            scrub: 0.5,
            invalidateOnRefresh: true,
            onToggle: (self) => pavilionPreview.classList.toggle("is-moving", self.isActive),
          },
        })
          .fromTo(
            pavilionPreviewPicture,
            { autoAlpha: 0 },
            {
              autoAlpha: 0,
              duration: 0.65,
              ease: "none",
            },
            0,
          )
          .to(
            pavilionPreviewPicture,
            {
              autoAlpha: 0.16,
              duration: 0.35,
              ease: "none",
            },
            0.65,
          );

        const pavilionTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: pavilionPhase,
            start: "top top",
            end: "bottom bottom",
            scrub: 0.85,
            invalidateOnRefresh: true,
            onToggle: (self) => {
              setMovingState(pavilionMotionLayers, self.isActive);
              if (!self.isActive) setPavilionAmbientState(self.progress, false);
            },
            onUpdate: (self) => {
              setPavilionAmbientState(self.progress, self.isActive);
              const shouldGlint = self.isActive && self.progress >= 0.8 && self.progress < 0.9;
              if (shouldGlint !== ringMomentActive) {
                ringMomentActive = shouldGlint;
                if (ringMomentActive) scheduleGlint(true);
                else clearGlintTimer();
              }
            },
            onLeave: () => {
              ringMomentActive = false;
              clearGlintTimer();
              setPavilionAmbientState(1, false);
            },
            onLeaveBack: () => {
              ringMomentActive = false;
              clearGlintTimer();
              setPavilionAmbientState(0, false);
            },
          },
        });

        pavilionTimeline
          .fromTo(
            staircase,
            { autoAlpha: 1, scale: stairAscentScale, y: 0 },
            {
              autoAlpha: 1,
              scale: () => stairAscentScale() * 1.06,
              y: 0,
              duration: 0.15,
              ease: "none",
              immediateRender: false,
            },
            0,
          )
          .fromTo(
            pavilionAssembly,
            { autoAlpha: 0, scale: 0.14, y: () => pavilionDistantY(0.14) },
            {
              autoAlpha: 0.56,
              scale: 0.2,
              y: () => pavilionDistantY(0.2),
              duration: 0.13,
              ease: "sine.out",
              immediateRender: false,
            },
            0.02,
          )
          .to(pavilionPreview, { autoAlpha: 0, duration: 0.12, ease: "sine.in" }, 0)
          .to(crestHaze, { autoAlpha: 0.9, scale: 1.12, yPercent: 12, duration: 0.18, ease: "sine.inOut" }, 0.02)
          .to(pavilionClouds, { autoAlpha: 0.8, scale: 1.07, duration: 0.5, ease: "none" }, 0)
          .to(
            pavilionAssembly,
            {
              autoAlpha: 0.9,
              scale: 0.62,
              y: () => pavilionApproachY(0.62, 0.5),
              duration: 0.2,
              ease: "none",
            },
            0.15,
          )
          .to(
            staircase,
            {
              scale: () => stairAscentScale() * 1.16,
              y: () => stairSummitTravel() * 0.5,
              duration: 0.2,
              ease: "none",
            },
            0.15,
          )
          .to(pavilionAssembly, { autoAlpha: 1, scale: 1, y: 0, duration: 0.15, ease: "none" }, 0.35)
          .to(
            staircase,
            {
              scale: () => stairAscentScale() * 1.27,
              y: stairSummitTravel,
              duration: 0.15,
              ease: "none",
            },
            0.35,
          )
          .to(pavilionCurtains, { autoAlpha: 0.2, duration: 0.12, ease: "sine.out" }, 0.5)
          .to(pavilionBanks, { autoAlpha: 0.9, duration: 0.14, ease: "sine.inOut" }, 0.48)
          .to(crestHaze, { autoAlpha: 0.08, scale: 1.34, yPercent: 58, duration: 0.2, ease: "sine.inOut" }, 0.44)
          .to(revealHaze, { autoAlpha: 0.84, y: 0, duration: 0.1, ease: "sine.out" }, 0.54);

        if (compactEffects) {
          pavilionTimeline
            .fromTo(
              couple,
              { autoAlpha: 0, y: 8, clipPath: "none" },
              {
                autoAlpha: 0.42,
                y: 4,
                clipPath: "none",
                duration: 0.1,
                ease: "sine.out",
                immediateRender: false,
              },
              0.62,
            )
            .to(couple, { autoAlpha: 1, y: 0, duration: 0.08, ease: "sine.inOut" }, 0.72);
        } else {
          pavilionTimeline
            .fromTo(
              couple,
              { autoAlpha: 0, clipPath: "inset(48% 0 0 0)" },
              {
                autoAlpha: 0.42,
                clipPath: "inset(20% 0 0 0)",
                duration: 0.1,
                ease: "sine.out",
                immediateRender: false,
              },
              0.62,
            )
            .to(couple, { autoAlpha: 1, clipPath: "inset(0% 0 0 0)", duration: 0.08, ease: "sine.inOut" }, 0.72);
        }

        pavilionTimeline
          .to(revealHaze, { autoAlpha: 0.06, y: "-9vh", duration: 0.14, ease: "sine.inOut" }, 0.7)
          .fromTo(ringHand, { autoAlpha: 0.35 }, { autoAlpha: 1, duration: 0.04 }, 0.78)
          .to(staircase, { autoAlpha: 0, duration: 0.08, ease: "sine.in" }, 0.72)
          .to(pavilionAssembly, { scale: 1.025, duration: 0.08, ease: "sine.inOut" }, 0.78)
          .to(pavilionAssembly, { scale: 0.96, y: finalSceneLift, autoAlpha: () => usesPortraitFinalComposition() ? 1 : 0.62, duration: 0.12, ease: "sine.inOut" }, 0.88)
          .to(pavilionPicture, { autoAlpha: () => usesPortraitFinalComposition() ? 0.62 : 1, duration: 0.1, ease: "sine.inOut" }, 0.88)
          .to(couple, { autoAlpha: () => usesPortraitFinalComposition() ? 0.96 : 0.74, duration: 0.1, ease: "sine.inOut" }, 0.88)
          .set(finalCopy, { pointerEvents: "auto" }, 0.89)
          .to(finalCopy, { autoAlpha: 1, y: 0, duration: 0.11, ease: "power2.out" }, 0.89);
      }

      select("[data-soft-reveal]").forEach((element) => {
        gsap.from(element, {
          autoAlpha: 0,
          y: 24,
          duration: 1,
          ease: "power2.out",
          scrollTrigger: { trigger: element, start: "top 86%", once: true },
        });
      });

      return () => {
        window.cancelAnimationFrame(initialAscentSync);
        ascentBeatTriggers.forEach((trigger) => trigger.kill());
        root.classList.remove("has-ascent-reveals");
        clearGlintTimer();
        setPavilionAmbientState(0, false);
      };
    });

    motion.add("(prefers-reduced-motion: reduce)", () => {
      const pavilionPhase = root.querySelector<HTMLElement>("[data-phase='pavilion']");
      if (!pavilionPhase) return;

      const showPavilion = () => root.classList.add("is-reduced-pavilion");
      const showFinal = () => root.classList.add("is-reduced-final");
      const hideFinal = () => root.classList.remove("is-reduced-final");
      const showAscent = () => {
        root.classList.remove("is-reduced-pavilion");
        hideFinal();
      };
      const pavilionTop = () => window.scrollY + pavilionPhase.getBoundingClientRect().top;
      const finalThreshold = () =>
        pavilionTop() + Math.max(0, pavilionPhase.offsetHeight - window.innerHeight) * 0.72;

      if (window.scrollY >= pavilionTop()) showPavilion();
      else showAscent();
      if (window.scrollY >= finalThreshold()) showFinal();

      const reducedTrigger = ScrollTrigger.create({
        trigger: pavilionPhase,
        start: "top top",
        end: "bottom bottom",
        onEnter: showPavilion,
        onEnterBack: showPavilion,
        onLeave: showPavilion,
        onLeaveBack: showAscent,
      });
      const reducedFinalTrigger = ScrollTrigger.create({
        trigger: pavilionPhase,
        start: () => `top+=${Math.max(0, pavilionPhase.offsetHeight - window.innerHeight) * 0.72} top`,
        end: "bottom bottom",
        onEnter: showFinal,
        onEnterBack: showFinal,
        onLeave: showFinal,
        onLeaveBack: hideFinal,
      });

      return () => {
        reducedTrigger.kill();
        reducedFinalTrigger.kill();
        showAscent();
      };
    });

    const rsvpScene = document.querySelector<HTMLElement>("[data-rsvp-scene]");
    const rsvpOpener = root.querySelector<HTMLElement>("[data-rsvp-open]");
    const rsvpFocusTarget = document.querySelector<HTMLElement>("[data-rsvp-focus]");
    const rsvpTransitionCloud = document.querySelector<HTMLElement>("[data-rsvp-transition-cloud]");
    const pavilionRsvpShift = root.querySelector<HTMLElement>("[data-pavilion-rsvp-shift]");
    const finalCopyShift = root.querySelector<HTMLElement>("[data-final-copy-shift]");

    if (
      rsvpScene
      && rsvpOpener
      && rsvpFocusTarget
      && rsvpTransitionCloud
      && pavilionRsvpShift
      && finalCopyShift
    ) {
      const documentElement = document.documentElement;
      const body = document.body;
      const skipLink = document.querySelector<HTMLElement>(".skip-link");
      const closeControls = Array.from(rsvpScene.querySelectorAll<HTMLElement>("[data-rsvp-close]"));
      const historyMarker = "ourJourneyRsvpGate";
      const backgroundSurfaces = [root, skipLink].filter(
        (surface): surface is HTMLElement => Boolean(surface),
      );
      const backgroundState = new Map<HTMLElement, { hadInert: boolean; ariaHidden: string | null }>();
      let rsvpState: "closed" | "opening" | "open" | "closing" = "closed";
      let returnFocusTarget: HTMLElement | null = rsvpOpener;
      let ownsRsvpHistoryEntry = false;
      let savedScrollX = 0;
      let savedScrollY = 0;
      let previousScrollRestoration: ScrollRestoration | null = null;
      let suspendedScrollTriggers = [] as ReturnType<typeof ScrollTrigger.getAll>;
      let bodyStyleSnapshot: {
        position: string;
        top: string;
        right: string;
        left: string;
        width: string;
        paddingRight: string;
      } | null = null;

      const historyStateObject = () =>
        history.state && typeof history.state === "object" ? { ...history.state } : {};

      const setBackgroundInactive = (inactive: boolean) => {
        if (inactive) {
          backgroundSurfaces.forEach((surface) => {
            if (!backgroundState.has(surface)) {
              backgroundState.set(surface, {
                hadInert: surface.hasAttribute("inert"),
                ariaHidden: surface.getAttribute("aria-hidden"),
              });
            }
            surface.inert = true;
            surface.setAttribute("inert", "");
            surface.setAttribute("aria-hidden", "true");
          });
          return;
        }

        backgroundSurfaces.forEach((surface) => {
          const previous = backgroundState.get(surface);
          if (!previous) return;
          surface.inert = previous.hadInert;
          if (previous.hadInert) surface.setAttribute("inert", "");
          else surface.removeAttribute("inert");
          if (previous.ariaHidden === null) surface.removeAttribute("aria-hidden");
          else surface.setAttribute("aria-hidden", previous.ariaHidden);
        });
        backgroundState.clear();
      };

      const lockInvitation = () => {
        if (bodyStyleSnapshot) return;

        savedScrollX = window.scrollX;
        savedScrollY = window.scrollY;
        bodyStyleSnapshot = {
          position: body.style.position,
          top: body.style.top,
          right: body.style.right,
          left: body.style.left,
          width: body.style.width,
          paddingRight: body.style.paddingRight,
        };
        previousScrollRestoration = history.scrollRestoration;
        history.scrollRestoration = "manual";

        suspendedScrollTriggers = ScrollTrigger.getAll();
        suspendedScrollTriggers.forEach((trigger) => trigger.disable(false, true));

        const scrollbarGap = Math.max(0, window.innerWidth - documentElement.clientWidth);
        const computedPaddingRight = Number.parseFloat(getComputedStyle(body).paddingRight) || 0;
        body.style.position = "fixed";
        body.style.top = `-${savedScrollY}px`;
        body.style.right = "0";
        body.style.left = "0";
        body.style.width = "100%";
        if (scrollbarGap > 0) body.style.paddingRight = `${computedPaddingRight + scrollbarGap}px`;
      };

      const unlockInvitation = () => {
        if (!bodyStyleSnapshot) return;

        const previousStyles = bodyStyleSnapshot;
        bodyStyleSnapshot = null;
        body.style.position = previousStyles.position;
        body.style.top = previousStyles.top;
        body.style.right = previousStyles.right;
        body.style.left = previousStyles.left;
        body.style.width = previousStyles.width;
        body.style.paddingRight = previousStyles.paddingRight;

        const previousScrollBehavior = documentElement.style.scrollBehavior;
        documentElement.style.scrollBehavior = "auto";
        window.scrollTo(savedScrollX, savedScrollY);
        suspendedScrollTriggers.forEach((trigger) => trigger.enable(false, false));
        suspendedScrollTriggers = [] as ReturnType<typeof ScrollTrigger.getAll>;
        ScrollTrigger.update();

        if (previousScrollRestoration !== null) {
          history.scrollRestoration = previousScrollRestoration;
          previousScrollRestoration = null;
        }

        window.requestAnimationFrame(() => {
          documentElement.style.scrollBehavior = previousScrollBehavior;
          if (orientationRefreshPending) {
            orientationRefreshPending = false;
            ScrollTrigger.refresh();
          }
        });
      };

      const setSceneAccessibility = (open: boolean) => {
        rsvpScene.inert = !open;
        if (open) rsvpScene.removeAttribute("inert");
        else rsvpScene.setAttribute("inert", "");
        rsvpScene.setAttribute("aria-hidden", open ? "false" : "true");
      };

      const finishOpen = () => {
        if (rsvpState !== "opening") return;
        rsvpState = "open";
        documentElement.classList.remove("is-rsvp-transitioning");
        rsvpFocusTarget.focus({ preventScroll: true });
      };

      const finishClose = () => {
        if (rsvpState !== "closing") return;
        rsvpState = "closed";
        documentElement.classList.remove("is-rsvp-open", "is-rsvp-transitioning");
        setSceneAccessibility(false);
        gsap.set(rsvpScene, { opacity: 0, y: 0, yPercent: 100 });
        gsap.set(rsvpTransitionCloud, { autoAlpha: 0, y: 0, yPercent: 58 });
        rsvpScene.scrollTop = 0;
        setBackgroundInactive(false);
        unlockInvitation();
        if (returnFocusTarget?.isConnected) returnFocusTarget.focus({ preventScroll: true });
        ownsRsvpHistoryEntry = false;
      };

      gsap.set(rsvpScene, { opacity: 0, y: 0, yPercent: 100 });
      gsap.set(rsvpTransitionCloud, { autoAlpha: 0, y: 0, yPercent: 58 });

      const rsvpTimeline = gsap.timeline({
        paused: true,
        onComplete: finishOpen,
        onReverseComplete: finishClose,
      });

      rsvpTimeline
        .to(rsvpOpener, { y: -2, duration: 0.1, ease: "power1.out" }, 0)
        .to(rsvpOpener, { y: 0, duration: 0.12, ease: "power1.in" }, 0.1)
        .to(
          pavilionRsvpShift,
          { y: "-3vh", autoAlpha: 0.75, duration: 0.48, ease: "power1.inOut" },
          0.16,
        )
        .to(
          finalCopyShift,
          { y: "-2vh", autoAlpha: 0, duration: 0.34, ease: "power1.in" },
          0.26,
        )
        .fromTo(
          rsvpScene,
          { opacity: 0, y: 0, yPercent: 100 },
          { opacity: 1, y: 0, yPercent: 0, duration: 0.68, ease: "power2.inOut" },
          0.22,
        )
        .fromTo(
          rsvpTransitionCloud,
          { autoAlpha: 0, y: 0, yPercent: 58 },
          { autoAlpha: 1, y: 0, yPercent: 0, duration: 0.36, ease: "power1.out" },
          0.1,
        )
        .to(
          rsvpTransitionCloud,
          { autoAlpha: 0, y: 0, yPercent: -60, duration: 0.45, ease: "power1.in" },
          0.46,
        );

      const openRsvp = (pushHistory: boolean, focusTarget: HTMLElement | null = rsvpOpener) => {
        if (rsvpState === "open" || rsvpState === "opening") return;

        if (rsvpState === "closing") {
          rsvpState = "opening";
          documentElement.classList.add("is-rsvp-transitioning");
          rsvpTimeline.play();
          return;
        }

        const activeElement = document.activeElement;
        returnFocusTarget = activeElement instanceof HTMLElement && activeElement !== body
          ? activeElement
          : focusTarget;
        rsvpState = "opening";
        lockInvitation();
        setBackgroundInactive(true);
        setSceneAccessibility(true);
        rsvpScene.scrollTop = 0;
        documentElement.classList.add("is-rsvp-open", "is-rsvp-transitioning");

        if (pushHistory) {
          history.pushState(
            { ...historyStateObject(), rsvpOpen: true, [historyMarker]: true },
            "",
            "#rsvp",
          );
          ownsRsvpHistoryEntry = true;
        } else {
          ownsRsvpHistoryEntry = Boolean(history.state?.[historyMarker]);
        }

        if (prefersReducedMotion) {
          rsvpTimeline.progress(1).pause();
          finishOpen();
        } else {
          rsvpTimeline.play(0);
        }
      };

      const closeRsvp = () => {
        if (rsvpState === "closed" || rsvpState === "closing") return;
        rsvpState = "closing";
        documentElement.classList.add("is-rsvp-transitioning");
        if (prefersReducedMotion) {
          rsvpTimeline.progress(0).pause();
          finishClose();
        } else {
          rsvpTimeline.reverse();
        }
      };

      const requestClose = () => {
        if (rsvpState === "closed" || rsvpState === "closing") return;
        if (ownsRsvpHistoryEntry && history.state?.[historyMarker]) {
          history.back();
          return;
        }

        const nextState = historyStateObject();
        delete nextState.rsvpOpen;
        delete nextState[historyMarker];
        history.replaceState(nextState, "", `${location.pathname}${location.search}`);
        ownsRsvpHistoryEntry = false;
        closeRsvp();
      };

      const focusableElements = () =>
        Array.from(
          rsvpScene.querySelectorAll<HTMLElement>(
            "a[href], button:not(:disabled), input:not([type='hidden']):not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex='-1'])",
          ),
        ).filter((element) => {
          const style = getComputedStyle(element);
          return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
        });

      const handleDialogKeydown = (event: KeyboardEvent) => {
        if (rsvpState === "closed") return;
        if (event.key === "Escape") {
          event.preventDefault();
          requestClose();
          return;
        }
        if (event.key !== "Tab") return;

        const focusable = focusableElements();
        if (focusable.length === 0) {
          event.preventDefault();
          rsvpFocusTarget.focus({ preventScroll: true });
          return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement;
        if (!rsvpScene.contains(active)) {
          event.preventDefault();
          (event.shiftKey ? last : first).focus();
        } else if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      };

      const handlePopState = (event: PopStateEvent) => {
        if (location.hash === "#rsvp") {
          ownsRsvpHistoryEntry = Boolean(event.state?.[historyMarker]);
          openRsvp(false);
        } else {
          ownsRsvpHistoryEntry = false;
          closeRsvp();
        }
      };

      const handlePageHide = () => {
        rsvpTimeline.kill();
        document.removeEventListener("keydown", handleDialogKeydown);
        window.removeEventListener("popstate", handlePopState);
        setSceneAccessibility(false);
        setBackgroundInactive(false);
        unlockInvitation();
        documentElement.classList.remove("is-rsvp-open", "is-rsvp-transitioning");
      };

      rsvpOpener.addEventListener("click", (event) => {
        event.preventDefault();
        openRsvp(true, rsvpOpener);
      });
      closeControls.forEach((control) => control.addEventListener("click", requestClose));
      document.addEventListener("keydown", handleDialogKeydown);
      window.addEventListener("popstate", handlePopState);
      window.addEventListener("pagehide", handlePageHide, { once: true });

      if (location.hash === "#rsvp") {
        history.replaceState({ ...historyStateObject(), rsvpOpen: true }, "", location.href);
        window.requestAnimationFrame(() => openRsvp(false));
      }
    }
  }
</script>
