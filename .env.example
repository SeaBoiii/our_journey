# ---------------------------------------------------------------------------
# Astro/browser build values. Everything prefixed PUBLIC_ is visible to users.
# ---------------------------------------------------------------------------

# Link back to the invitation after Moments moves to another origin.
PUBLIC_JOURNEY_URL=

# Safe default: Phase 1 IndexedDB mock mode. Set to remote only after the
# Worker, Supabase project, allowed origins, and OAuth secrets are ready.
PUBLIC_MOMENTS_BACKEND_PROVIDER=mock
PUBLIC_MOMENTS_API_URL=

# Remote video uploads remain off until the resumable path is manually proven.
PUBLIC_MOMENTS_ALLOW_VIDEOS=false

# Browser-safe Supabase project values used only for admin magic-link auth.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Worker values. Never expose these through PUBLIC_ variables and
# never add their real values to this file. Configure secrets with Wrangler.
# workers/moments-api/.dev.vars.example is the local Worker template.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MOMENTS_DERIVATIVES_BUCKET=moments-gallery

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ORIGINALS_FOLDER_ID=
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=

# Exact comma-separated origins; paths, wildcards, and arbitrary reflection are
# rejected. Example values belong in local secret/config storage, not here.
MOMENTS_ALLOWED_ORIGINS=

# Generate at least 32 random bytes. Used to sign anonymous guest sessions and
# encrypt opaque upload tickets containing the private Drive resumable URI.
MOMENTS_SESSION_SECRET=

MOMENTS_ALLOW_VIDEOS=false
MOMENTS_REQUIRE_MODERATION=true
MOMENTS_SIGNED_URL_TTL_SECONDS=900
