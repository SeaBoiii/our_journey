# Phase 1 needs no credentials. This optional browser-safe URL is used by the
# “Our Journey” link after Moments moves to a separate origin.
PUBLIC_JOURNEY_URL=

# Future browser-safe endpoint/config values (not consumed in mock mode):
PUBLIC_MOMENTS_API_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Never prefix private values with PUBLIC_. The following belong only in the
# future Cloudflare Worker/Pages Function environment, never in this static app:
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ORIGINALS_FOLDER_ID=
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
